# ค่าสำหรับ docker-compose.prod.yml
# ไฟล์จริง (.env) ถูก render โดย Ansible role web-portal — อย่า commit ไฟล์จริง

# IP ที่ผูก port — ใช้ Tailscale IP ของเครื่องนี้ ไม่ใช่ 0.0.0.0
# เพื่อไม่ให้ service โผล่บน LAN หรือ interface อื่นโดยไม่ตั้งใจ
BIND_IP=100.68.206.79

# Postgres — ต้องตรงกับ DATABASE_URL ใน backend/.env
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=virtual_lab

# URL ที่ frontend ใช้เรียก backend
# ถูกฝังลง bundle ตอน build ไม่ใช่ตอน runtime
VITE_API_URL=http://100.68.206.79:8000/api
