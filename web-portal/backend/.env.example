# Application
APP_NAME=FastAPI Backend
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtual_lab

# Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ADMIN_SESSION_SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Comma-separated immediate Tailscale proxy IPs/CIDRs; empty denies SQLAdmin access.
TAILSCALE_TRUSTED_PROXY_CIDRS_STR=

# CORS Origins (comma-separated, no spaces around comma)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# Cloudflare R2 (S3-compatible storage via Boto3)
# วิธีหา: https://dash.cloudflare.com/ → เลือก account → ดูที่ URL หรือ sidebar
# หรือไปที่ R2 → มุมขวาบน จะเห็น Account ID
R2_ACCOUNT_ID=your_account_id_here

# ชื่อ bucket ที่สร้างใน R2
# วิธีสร้าง: R2 → Create bucket → ตั้งชื่อ → Create
R2_BUCKET_NAME=virtual-lab-images

# API Token สำหรับเข้าถึง R2 (ทำงานเหมือน AWS Access Key)
# วิธีสร้าง:
# 1. ไปที่ R2 → Manage R2 API Tokens (หรือ Settings → API Tokens)
# 2. คลิก "Create API Token"
# 3. ตั้งชื่อ token เช่น "virtual-lab-backend"
# 4. เลือก Permissions: "Admin Read & Write" (หรือ Object Read & Write ถ้าต้องการจำกัด)
# 5. (Optional) จำกัด TTL หรือ IP ได้
# 6. คลิก "Create API Token"
# 7. คัดลอก Access Key ID และ Secret Access Key (Secret จะแสดงครั้งเดียว!)
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Endpoint URL สำหรับ Boto3 (แทน ACCOUNT_ID ด้วยค่าจริงจาก R2_ACCOUNT_ID ด้านบน)
# รูปแบบ: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# ตัวอย่าง: https://abc123def456.r2.cloudflarestorage.com
R2_ENDPOINT_URL=https://your_account_id_here.r2.cloudflarestorage.com

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Kubernetes Configuration (Optional)
K8S_ENABLED=True
KUBECONFIG_PATH=./kubeconfig.yaml
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30

# Docker Registry for SkyPilot
# ใช้สำหรับ pull container images ลงไปใน Kubernetes cluster
DOCKER_REGISTRY_HOST=100.127.74.48:5001
DOCKER_REGISTRY_PREFIX=docker:100.127.74.48:5001

# AWS (lab ที่ run_target = AWS) ค่าตาม VPC vlab-ecr-pull ใน branch infra/ecr-pull-experiment
# backend ต้องมี AWS credential (env / profile / IAM role) ที่มีสิทธิ์ ecr:GetAuthorizationToken
# + pull repo ของ lab (token ใช้สิทธิ์ของ identity นี้ตอน EC2 pull)
AWS_REGION=ap-southeast-1
# AMI ต้องมี AWS_USE_DUALSTACK_ENDPOINT=true ใน /etc/environment (r2 ขึ้นไป) ไม่งั้น autostop ลบเครื่องไม่ได้
AWS_LAB_AMI=ami-0da9046ec7f57f3af
AWS_INSTANCE_TYPE=m7i-flex.large
AWS_DISK_SIZE=30
# ต้องเป็น dual-stack (...dkr-ecr.<region>.on.aws) เพราะ private subnet ออกได้แค่ IPv6
ECR_REGISTRY_HOST=568318158381.dkr-ecr.ap-southeast-1.on.aws
