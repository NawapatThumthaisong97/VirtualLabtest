# Application
APP_NAME=FastAPI Backend
APP_VERSION=1.0.0
DEBUG=True
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtual_lab

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated, no spaces around comma)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id_here
R2_BUCKET_NAME=virtual-lab-images
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_ENDPOINT_URL=https://your_account_id.r2.cloudflarestorage.com

# Redis (Optional)
REDIS_URL=redis://localhost:6379/0

# Kubernetes Configuration (Optional)
K8S_ENABLED=True
KUBECONFIG_PATH=./kubeconfig.yaml
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30

# Docker Registry for SkyPilot
# ใช้สำหรับ pull container images ลงไปใน Kubernetes cluster
DOCKER_REGISTRY_HOST=100.127.74.48:5001
DOCKER_REGISTRY_PREFIX=docker:100.127.74.48:5001

# AWS (lab ที่ run_target = AWS) ค่าตาม VPC vlab-ecr-pull ใน branch infra/ecr-pull-experiment
# backend ต้องมี AWS credential (env / profile / IAM role) ที่มีสิทธิ์ ecr:GetAuthorizationToken
# + pull repo ของ lab (token ใช้สิทธิ์ของ identity นี้ตอน EC2 pull)
AWS_REGION=ap-southeast-1
AWS_LAB_AMI=ami-097929ad492bfc681
AWS_INSTANCE_TYPE=m7i-flex.large
AWS_DISK_SIZE=30
# ต้องเป็น dual-stack (...dkr-ecr.<region>.on.aws) เพราะ private subnet ออกได้แค่ IPv6
ECR_REGISTRY_HOST=568318158381.dkr-ecr.ap-southeast-1.on.aws
