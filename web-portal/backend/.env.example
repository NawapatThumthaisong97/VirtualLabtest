# =============================================================================
# Application Configuration
# =============================================================================

# Application Settings
APP_NAME=FastAPI Backend
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development  # "development" or "production"
API_PREFIX=/api

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtual_lab

# =============================================================================
# Security Configuration
# =============================================================================

# Secret Keys (Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=your-secret-key-change-this-in-production-use-random-string
ADMIN_SESSION_SECRET_KEY=change-this-admin-session-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax

# University SSO (Google OAuth2 / OIDC)
ALLOWED_EMAIL_DOMAINS_STR=dome.tu.ac.th,tu.ac.th
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback

# Tailscale Configuration
# Development: Leave empty to skip Tailscale check
# Production: REQUIRED - set to Tailscale CIDR range (e.g., "100.64.0.0/10")
TAILSCALE_TRUSTED_PROXY_CIDRS_STR=""

# =============================================================================
# CORS Configuration
# =============================================================================

# CORS Origins (comma-separated, no spaces around comma)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173

# =============================================================================
# Cloudflare R2 Configuration
# =============================================================================

R2_ACCOUNT_ID=your-r2-account-id
R2_BUCKET_NAME=virtual-lab-images
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
# Optional: defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=
# Presigned upload URL lifetime in seconds (60 - 604800)
R2_PRESIGN_EXPIRES_SECONDS=3600
# Must match webhook_secret in terraform/cloudflare/r2-event-pipeline (Webhook-Secret header)
R2_WEBHOOK_SECRET=change-me
# Secret for POST /api/webhook/approve-lab-image (Webhook-Secret header).
# Keep it different from R2_WEBHOOK_SECRET; generate with: openssl rand -hex 32
LAB_IMAGE_APPROVE_WEBHOOK_SECRET=change-me-too

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================

REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Kubernetes Configuration
# =============================================================================

K8S_ENABLED=True
KUBECONFIG_PATH=./kubeconfig.yaml
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30

# =============================================================================
# Docker Registry Configuration
# =============================================================================

# Docker Registry for SkyPilot
DOCKER_REGISTRY_HOST=100.127.74.48:5001
DOCKER_REGISTRY_PREFIX=docker:100.127.74.48:5001

# =============================================================================
# AWS Configuration (for AWS lab deployment)
# =============================================================================

AWS_REGION=ap-southeast-1
AWS_LAB_AMI=ami-0da9046ec7f57f3af
AWS_INSTANCE_TYPE=m7i-flex.large
AWS_DISK_SIZE=30
ECR_REGISTRY_HOST=568318158381.dkr-ecr.ap-southeast-1.on.aws

# =============================================================================
# Session Reconciliation
# =============================================================================

# How often to check if RUNNING sessions are still alive (0 = disabled)
SESSION_RECONCILE_INTERVAL_SECONDS=60
