
# =============================================================================
# Virtual Lab - Backend Environment Configuration Example
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env แล้วตั้งค่าตามสภาพแวดล้อมที่ใช้งาน
# cp .env.example .env

# =============================================================================
# 1. Application Settings
# =============================================================================
APP_NAME=FastAPI Backend
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
API_PREFIX=/api

# =============================================================================
# 2. Database Configuration (PostgreSQL) - [REQUIRED]
# =============================================================================
# ตัวอย่าง: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:password@localhost:5432/virtual_lab

# =============================================================================
# 3. Security & JWT Authentication - [REQUIRED]
# =============================================================================
# สร้างคีย์สุ่ม (ความยาวขั้นต่ำ 32 ตัวอักษร) ด้วย:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
ADMIN_SESSION_SECRET_KEY=change-this-to-another-secure-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security Settings
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=lax
# ว่างไว้ใน Dev หรือระบุ domain เช่น .yourdomain.com
AUTH_COOKIE_DOMAIN=

# =============================================================================
# 4. Authentication: Thammasat University REST API (AD Verify)
# =============================================================================
# ใช้ยืนยันตัวตนด้วย Username/Password ของ TU (นักศึกษา / บุคลากร)
TU_API_ENABLED=False
TU_API_URL=https://restapi.tu.ac.th/api/v1/auth/Ad/verify
TU_API_APP_KEY=your_tu_api_application_key_here  # ได้รับจาก https://restapi.tu.ac.th/tuapi/Authkey

# =============================================================================
# 5. Authentication: University SSO (Google OAuth2 / OIDC) - [OPTIONAL]
# =============================================================================
# โดเมนอีเมลที่อนุญาตให้ล็อกอิน (คั่นด้วย comma)
ALLOWED_EMAIL_DOMAINS_STR=dome.tu.ac.th,tu.ac.th

# ตั้งค่าจาก Google Cloud Console (ใส่เฉพาะกรณีต้องการเปิดปุ่ม Login ด้วย Google - ถ้าใช้ TU API ปล่อยว่างได้เลย)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/sso/callback
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_USERINFO_URI=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_TOKENINFO_URI=https://oauth2.googleapis.com/tokeninfo

# =============================================================================
# 6. Network, CORS & Tailscale
# =============================================================================
# CORS Origins ที่อนุญาต (คั่นด้วย comma ไม่มีเว้นวรรค)
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:5173,http://localhost:5174

# Tailscale Trusted Proxy (สำหรับ SQLAdmin และ Lab Client Verification)
# Development: ปล่อยว่างไว้เพื่อข้ามการตรวจ Tailscale
# Production: กำหนด IP หรือ CIDR เช่น "100.64.0.0/10"
TAILSCALE_TRUSTED_PROXY_CIDRS_STR=

# =============================================================================
# 7. Storage (Local & Cloudflare R2)
# =============================================================================
# โฟลเดอร์เก็บไฟล์เอกสารแลปแบบ Local (relative กับ root backend)
STORAGE_ROOT=storage

# Cloudflare R2 สำหรับเก็บ Image / ไฟล์ขนาดใหญ่ (Optional สำหรับ Local Dev)
R2_ACCOUNT_ID=your_r2_account_id
R2_BUCKET_NAME=virtual-lab-images
<<<<<<< HEAD
