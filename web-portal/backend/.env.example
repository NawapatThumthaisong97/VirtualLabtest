# =============================================================================
# 8. Redis Configuration (Optional)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# 9. Kubernetes Cluster (K3s / K8s) - (Optional for Local Dev)
# =============================================================================
K8S_ENABLED=False
KUBECONFIG_PATH=./kubeconfig.yaml
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30

# =============================================================================
# 10. Docker Registry for SkyPilot
# =============================================================================
DOCKER_REGISTRY_HOST=100.127.74.48:5001
DOCKER_REGISTRY_PREFIX=docker:100.127.74.48:5001

# =============================================================================
# 11. SkyPilot Cluster Configuration (Optional)
# =============================================================================
# ว่างไว้ = ใช้ API Server ในเครื่อง (127.0.0.1:46580)
SKYPILOT_API_SERVER_ENDPOINT=
SKYPILOT_SERVICE_ACCOUNT_TOKEN=

# =============================================================================
# 12. AWS Lab Deployment (Optional - สำหรับแลปที่ run_target = aws)
# =============================================================================
AWS_REGION=ap-southeast-1
AWS_LAB_AMI=ami-0da9046ec7f57f3af
AWS_INSTANCE_TYPE=m7i-flex.large
AWS_DISK_SIZE=30
ECR_REGISTRY_HOST=568318158381.dkr-ecr.ap-southeast-1.on.aws

# =============================================================================
# 13. Lab Session & Prewarm Scheduler
# =============================================================================
# ตรวจสอบ session ทุกๆ กี่วินาที (0 = ปิด)
SESSION_RECONCILE_INTERVAL_SECONDS=60

# Pre-pull container images ก่อนเริ่มคาบเรียน (DaemonSet)
PREWARM_ENABLED=False
PREWARM_INTERVAL_SECONDS=60
PREWARM_LEAD_MINUTES=30
PREWARM_NODE_GRACE_MINUTES=5

# Warm pod ประจำเครื่องแลป
WARM_POD_ENABLED=False
WARM_POD_WAIT_SECONDS=60

# วิธีสร้าง Lab บนเครื่องแลป ("pod" หรือ "skypilot")
LAB_MACHINE_LAUNCH=pod
DIRECT_POD_READY_TIMEOUT=180
LAB_ISOLATION_ENABLED=False

