# คัดลอกเป็น inventory.yml แล้วใส่ IP จริง (inventory.yml ถูก gitignore ไว้)
#
# ชื่อ host ต้องไม่ซ้ำกับชื่อ group ไม่งั้น Ansible จะเตือน
# "Found both group and host with same name" และการอ้าง groups[...] อาจกำกวม
# จึงใช้ master-1 / webportal-1 แทน master / webportal

all:
  children:
    master:
      hosts:
        master-1:
          ansible_host: "100.0.0.1"
    workers:
      hosts:
        worker-1:
          ansible_host: "100.0.0.2"
    registry:
      hosts:
        registry-host:
          ansible_host: "100.0.0.3"
    webportal:
      hosts:
        webportal-1:
          ansible_host: "100.0.0.4"
  vars:
    ansible_user: "your-ssh-user"
    ansible_become: yes
    ansible_become_method: sudo
