# {{ ansible_managed }}
# ไฟล์นี้ถูก generate โดย Ansible role web-service — แก้ที่ template ไม่ใช่ที่นี่

# Application
APP_NAME=Virtual Lab Backend
APP_VERSION=1.0.0
DEBUG={{ webservice_debug | string }}
API_PREFIX={{ webservice_api_prefix }}

# Database — backend ใช้ host network ต่อ db ที่ publish ไว้แค่ 127.0.0.1 (docker-compose.prod.yml)
DATABASE_URL=postgresql://{{ webservice_postgres_user }}:{{ webservice_postgres_password }}@127.0.0.1:5432/{{ webservice_postgres_db }}

# Security
SECRET_KEY={{ webservice_secret_key }}
# session ของหน้า admin (sqladmin)
ADMIN_SESSION_SECRET_KEY={{ webservice_admin_session_secret_key }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — frontend เสิร์ฟจาก Tailscale IP ต้องอยู่ใน allow list
# ไม่งั้น browser จะ block ทุก request จากหน้าเว็บ
CORS_ORIGINS_STR=http://{{ webservice_bind_ip }},http://{{ webservice_bind_ip }}:{{ webservice_http_port }}

# Storage — path ใน container ที่ mount volume ไว้
STORAGE_ROOT=storage

# Kubernetes — kubeconfig ถูก mount แบบ read-only ที่ path นี้
K8S_ENABLED={{ webservice_k8s_enabled | string }}
KUBECONFIG_PATH=/app/kubeconfig.yaml

# KUBECONFIG_PATH ข้างบนเป็นค่าที่ "แอป" อ่าน แต่ kubectl กับ SkyPilot เป็นโปรแกรม
# แยกต่างหากที่ถูกเรียกผ่าน subprocess มันไม่รู้จักตัวแปรนั้น และจะไปหา
# ~/.kube/config เป็นค่าเริ่มต้นซึ่งไม่มีใน container ต้องบอกผ่าน KUBECONFIG
KUBECONFIG=/app/kubeconfig.yaml

# registry ที่ SkyPilot ดึง image ของ lab ไปสร้าง pod
# ถ้าไม่ตั้ง โค้ดจะ fallback ไปใช้ค่า default ที่ฮาร์ดโค้ดไว้ซึ่งเป็น registry เก่า
DOCKER_REGISTRY_HOST={{ webservice_registry_endpoint }}
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30

# SkyPilot กลาง (helm บน master, role skypilot-node) — backend ส่ง launch ไปที่นี่ ไม่ใช้ SkyPilot ใน container
# token = service account ของ backend สร้างจาก dashboard (แสดงครั้งเดียว) แล้วใส่ใน group_vars
# ไม่ตั้ง endpoint = ใช้ API server ใน container (ของเดิม) ดู docs/SKYPILOT_CENTRAL_SERVER.md
{% if webservice_skypilot_endpoint %}
SKYPILOT_API_SERVER_ENDPOINT={{ webservice_skypilot_endpoint }}
SKYPILOT_SERVICE_ACCOUNT_TOKEN={{ webservice_skypilot_token }}
{% endif %}

# AWS — server กลางเป็นคน launch EC2 ส่วน backend ใช้แค่ขอ ECR token
# credential เป็นไฟล์ aws-credentials (profile skypilot = IAM user Skypilot-IAM) mount ที่ /root/.aws/credentials
AWS_REGION={{ webservice_aws_region }}
AWS_LAB_AMI={{ webservice_aws_lab_ami }}
AWS_INSTANCE_TYPE={{ webservice_aws_instance_type }}
AWS_DISK_SIZE={{ webservice_aws_disk_size }}
ECR_REGISTRY_HOST={{ webservice_ecr_registry_host }}
AWS_PROFILE=skypilot

# prewarm / warm pod / lab isolation
PREWARM_ENABLED={{ webservice_prewarm_enabled | string | lower }}
PREWARM_LEAD_MINUTES={{ webservice_prewarm_lead_minutes }}
WARM_POD_ENABLED={{ webservice_warm_pod_enabled | string | lower }}
LAB_ISOLATION_ENABLED={{ webservice_lab_isolation_enabled | string | lower }}
LAB_MACHINE_LAUNCH={{ webservice_lab_machine_launch }}
