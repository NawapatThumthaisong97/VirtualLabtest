# {{ ansible_managed }}
# ค่าที่ docker-compose.prod.yml อ่าน — generate โดย Ansible role web-service

BIND_IP={{ webservice_bind_ip }}

POSTGRES_USER={{ webservice_postgres_user }}
POSTGRES_PASSWORD={{ webservice_postgres_password }}
POSTGRES_DB={{ webservice_postgres_db }}
# DB ที่ Tailscale IP ให้ Grafana ของ SIEM (บน master) อ่าน — ปิดอยู่ = 127.0.0.2 (loopback อีกตัว ข้างนอกเข้าไม่ได้)
DB_SIEM_BIND_IP={{ webservice_bind_ip if webservice_siem_grafana_ro_password else '127.0.0.2' }}

# ฝังลง frontend bundle ตอน build — ต้องเป็น URL ที่ browser ของผู้ใช้เรียกถึงได้
# ไม่ใช่ชื่อ service ใน compose (browser อยู่นอก docker network)
VITE_API_URL=http://{{ webservice_bind_ip }}:{{ webservice_api_port }}{{ webservice_api_prefix }}
