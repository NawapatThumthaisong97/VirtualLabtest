# Managed by Ansible (siem-layer1-collector)
# Falco eBPF Configuration for K3s Worker Nodes & AWS EC2/SkyPilot Instances
engine:
  kind: {{ falco_engine_kind }}
  modern_ebpf:
    cpus_for_each_buffer: 2
    buf_size_preset: 4

rules_files:
  - /etc/falco/falco_rules.yaml
  - /etc/falco/rules.d/vlab_custom_rules.yaml

json_output: true
json_include_output_property: true
json_include_tags_property: true
priority: warning
buffered_outputs: false

file_output:
  enabled: true
  keep_alive: true
  filename: {{ falco_alert_log_path }}

http_output:
  enabled: true
  url: "http://127.0.0.1:{{ falco_local_webhook_port }}/falco"
  user_agent: "falco-ebpf-vlab/1.0"

stdout_output:
  enabled: true
