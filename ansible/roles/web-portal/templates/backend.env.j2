# {{ ansible_managed }}
# ไฟล์นี้ถูก generate โดย Ansible role web-portal — แก้ที่ template ไม่ใช่ที่นี่

# Application
APP_NAME=Virtual Lab Backend
APP_VERSION=1.0.0
DEBUG={{ webportal_debug | string }}
API_PREFIX={{ webportal_api_prefix }}

# Database — host คือชื่อ service ใน compose ไม่ใช่ localhost
DATABASE_URL=postgresql://{{ webportal_postgres_user }}:{{ webportal_postgres_password }}@db:5432/{{ webportal_postgres_db }}

# Security
SECRET_KEY={{ webportal_secret_key }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS — frontend เสิร์ฟจาก Tailscale IP ต้องอยู่ใน allow list
# ไม่งั้น browser จะ block ทุก request จากหน้าเว็บ
CORS_ORIGINS_STR=http://{{ webportal_bind_ip }},http://{{ webportal_bind_ip }}:{{ webportal_http_port }}

# Storage — path ใน container ที่ mount volume ไว้
STORAGE_ROOT=storage

# Kubernetes — kubeconfig ถูก mount แบบ read-only ที่ path นี้
K8S_ENABLED={{ webportal_k8s_enabled | string }}
KUBECONFIG_PATH=/app/kubeconfig.yaml

# KUBECONFIG_PATH ข้างบนเป็นค่าที่ "แอป" อ่าน แต่ kubectl กับ SkyPilot เป็นโปรแกรม
# แยกต่างหากที่ถูกเรียกผ่าน subprocess มันไม่รู้จักตัวแปรนั้น และจะไปหา
# ~/.kube/config เป็นค่าเริ่มต้นซึ่งไม่มีใน container ต้องบอกผ่าน KUBECONFIG
KUBECONFIG=/app/kubeconfig.yaml

# registry ที่ SkyPilot ดึง image ของ lab ไปสร้าง pod
# ถ้าไม่ตั้ง โค้ดจะ fallback ไปใช้ค่า default ที่ฮาร์ดโค้ดไว้ซึ่งเป็น registry เก่า
DOCKER_REGISTRY_HOST={{ webportal_registry_endpoint }}
K8S_DEFAULT_NAMESPACE=default
K8S_TIMEOUT=30
