# {{ ansible_managed }}
# ค่าที่ docker-compose.prod.yml อ่าน — generate โดย Ansible role web-portal

BIND_IP={{ webportal_bind_ip }}

POSTGRES_USER={{ webportal_postgres_user }}
POSTGRES_PASSWORD={{ webportal_postgres_password }}
POSTGRES_DB={{ webportal_postgres_db }}

# ฝังลง frontend bundle ตอน build — ต้องเป็น URL ที่ browser ของผู้ใช้เรียกถึงได้
# ไม่ใช่ชื่อ service ใน compose (browser อยู่นอก docker network)
VITE_API_URL=http://{{ webportal_bind_ip }}:{{ webportal_api_port }}{{ webportal_api_prefix }}
