# {{ ansible_managed }}
[Unit]
Description=Sync camp registry images to ECR
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ ecr_sync_user }}
Group={{ ecr_sync_user }}
EnvironmentFile={{ ecr_sync_config_dir }}/config.env
# key อ่านได้เฉพาะ root, systemd copy เข้า $CREDENTIALS_DIRECTORY ให้ service นี้คนเดียว
LoadCredential=aws.env:{{ ecr_sync_config_dir }}/aws.env
RuntimeDirectory=vlab-ecr-sync
RuntimeDirectoryMode=0700
# skopeo พัก blob ที่นี่ (ไม่ใช้ /run ที่เป็น RAM)
CacheDirectory=vlab-ecr-sync
CacheDirectoryMode=0700
Environment=HOME=/var/cache/vlab-ecr-sync TMPDIR=/var/cache/vlab-ecr-sync
ExecStart=/usr/bin/python3 {{ ecr_sync_install_dir }}/ecr_sync.py
TimeoutStartSec=6h

# hardening: ไม่มี root, ไม่มี capability, เขียนได้แค่ cache/runtime ของตัวเอง
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
