# {{ ansible_managed }}
# ไฟล์นี้ถูก render โดย ansible/build-images.yml — แก้ที่ ansible/templates/ ไม่ใช่ที่นี่
# (image_id เคยเป็น IP hardcode แล้วค้างชี้ registry เก่า จึงดึงจาก inventory แทน)
#
# SkyPilot ตัดสินใจว่าจะรันที่ไหน (k8s บ้านเรา, AWS, ฯลฯ) - image นี้มีครบทั้ง 3 service
# (server/client/ide) bake ไว้แล้ว รันเป็น process เดียวกันในตัวเดียว ไม่มี Docker ซ้อน
resources:
  image_id: docker:{{ registry_endpoint }}/skypilot/music-lab:{{ lab_image_tag }}
  cpus: 2+
  memory: 4+
  ports:
    - 8080  # server API
    - 5173  # client (Vite)
    - 8443  # ide (code-server, password: musiclab หรือตาม $IDE_PASSWORD)

run: |
  /run.sh
